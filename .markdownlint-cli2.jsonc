{
  // Self-contained on purpose: this is a public repo, so it must not point at
  // an absolute path in anyone's home directory.
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD036": false,
    "MD041": false,
    "MD060": false,
    // The only raw HTML in README.md is picture/source/img for the
    // theme-aware wordmark, and p to centre it and the prose under it
    "MD033": {
      "allowed_elements": [
        "picture",
        "source",
        "img",
        "p",
        "a"
      ]
    }
  }
}
