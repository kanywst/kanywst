{
  // Self-contained on purpose: this is a public repo, so it must not point at
  // an absolute path in anyone's home directory.
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD036": false,
    "MD041": false,
    "MD060": false,
    // Two kinds of raw HTML live in README.md, and nothing else does:
    //   - picture/source/img for the theme-aware wordmark, and p to centre it
    //     and the prose under it
    //   - table/code for the guest book between the GUESTBOOK:START/END
    //     markers, written by .github/workflows/guestbook.yml via
    //     scripts/update_guestbook.py, since markdown has no way to centre a table
    "MD033": {
      "allowed_elements": [
        "picture",
        "source",
        "img",
        "p",
        "h2",
        "table",
        "thead",
        "tbody",
        "tr",
        "th",
        "td",
        "code",
        "a"
      ]
    }
  }
}
